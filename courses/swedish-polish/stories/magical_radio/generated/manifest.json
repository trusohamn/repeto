    "1": {
      "titles": {
        "pl": "Stary stół",
        "sv": "Det gamla bordet",
        "en": "The Old Table"
      },
      "targets": {
        "pl": {
          "audio_file": "01_chapter_01_sv_pl_2026-10-28_15-07-18.mp3",
          "manifest_file": "01_chapter_01_sv_pl_2026-10-28_15-07-18.json",
          "total_duration_ms": 311806,
          "chapter_reading": {
            "text": "Jest sobota. Maja ma dziewięć lat, a jej brat Tomek ma sześć lat. Razem idą na pchli targ. W rogu stoi stary stół, a na stole – drewniane radio. Ma złote pokrętła i kolorowe przyciski. Gdy Maja podchodzi bliżej, radio nagle cicho szumi: Dzyń! Na radiu pojawia się złoty napis: „Dla Mai i Tomka”. Dzieci otwierają szeroko oczy.",
            "start_ms": 273958,
            "end_ms": 311806
          },
