    "2": {
      "titles": {
        "pl": "Głos z radia",
        "sv": "En röst ur radion",
        "en": "A Voice from the Radio"
      },
      "targets": {
        "pl": {
          "audio_file": "02_chapter_02_sv_pl_2026-10-28_15-07-18.mp3",
          "manifest_file": "02_chapter_02_sv_pl_2026-10-28_15-07-18.json",
          "total_duration_ms": 257960,
          "chapter_reading": {
            "text": "Dzieci niosą radio do domu. Tomek naciska niebieski przycisk. Z radia wylatuje mała chmurka, która pachnie cynamonem. – Cześć, odkrywcy! – mówi wesoły głos. – Nazywam się Radiofon. W waszym ogrodzie, pod starym drzewem, leży klucz. Weźcie latarkę i kawałek sera!",
            "start_ms": 229592,
            "end_ms": 257960
          },
          "chapter_introduction": {
